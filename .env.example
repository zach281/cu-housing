# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These two are public by design (they ship to the browser); RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Used to build links in auth emails. Your Vercel URL in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Never add the service-role / secret key here or to any NEXT_PUBLIC_ variable.
