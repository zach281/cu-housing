# Copy to .env.local and fill in from Supabase → Project Settings → API.
# These two are public by design (they ship to the browser); RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional. Links in auth emails use this address. On Vercel it defaults to
# your production domain automatically; set it only for a custom domain.
# SITE_URL=https://yourdomain.com

# Never add the service-role / secret key here or to any NEXT_PUBLIC_ variable.
